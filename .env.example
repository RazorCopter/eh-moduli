# ========================================
# EHModuli - Production Deployment Configuration
# ========================================
#
# IMPORTANT: Copy this file to .env and update all values
# Do NOT commit .env to Git - it's in .gitignore for security
#
# Generated SECRET_KEY and POSTGRES_PASSWORD:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# For secure password:
#   openssl rand -base64 32
#

# ========================================
# Application Settings
# ========================================

# Django deployment environment (development | production)
# Use 'production' for Synology NAS
ENVIRONMENT=production

# Enable debugging (False for production)
DEBUG=False

# Secret key for session encryption and CSRF tokens
# REQUIRED: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# EXAMPLE: 8hxF!2v@9Lq$pR%nB&m+K=j*L(I)U^W[X]Y{Z|A}B~C
SECRET_KEY=CHANGE_ME_TO_RANDOM_VALUE

# Application port on host (NAS external port)
# Example: 6060 means access via http://NAS_IP:6060
APP_PORT=6060

# Timezone for application
TZ=Europe/Rome

# ========================================
# Database Configuration
# ========================================

# PostgreSQL database name
POSTGRES_DB=document_collector

# PostgreSQL user
POSTGRES_USER=collector_user

# PostgreSQL password (required)
# REQUIRED: Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# PostgreSQL connection details
# In docker-compose, use 'db' as hostname
# For external connections, use NAS IP or hostname
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database connection timeout (seconds)
# Increase if NAS is slow to start services
DB_WAIT_TIMEOUT=90

# ========================================
# Django Security Settings
# ========================================

# Allowed hosts for this Django instance
# For Synology: localhost,IP_OF_NAS or hostname
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100,nas.local
ALLOWED_HOSTS=localhost,127.0.0.1,NAS_IP_HERE

# CSRF trusted origins for form submissions
# Add your domain or NAS IP with protocol
# Example: http://192.168.1.100:6060,http://nas.local:6060
CSRF_TRUSTED_ORIGINS=http://localhost:6060,http://NAS_IP_HERE:6060

# Enable secure cookies (HTTPS only)
# Set to True only when HTTPS reverse proxy is configured
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# ========================================
# Docker Container Configuration
# ========================================

# Synology volume paths (create these directories on NAS)
# APP_DATA_PATH: Django app data, static files, temp uploads
# POSTGRES_DATA_PATH: PostgreSQL data directory (critical for persistence)
# CUSTOMER_DOCUMENTS_PATH: Host path on Synology NAS (used in docker-compose.yml)
# CUSTOMER_DOCUMENTS_CONTAINER_PATH: Internal path inside container (must match docker-compose mount)
# BACKUP_PATH: Backup location

# For Synology - use /volume1/ paths
APP_DATA_PATH=/volume1/docker/eh-moduli/appdata
POSTGRES_DATA_PATH=/volume1/docker/eh-moduli/postgres
# Host path (Synology): /volume1/Clienti
CUSTOMER_DOCUMENTS_PATH=/volume1/Clienti
# Container path: matches docker-compose.yml volume mount
CUSTOMER_DOCUMENTS_CONTAINER_PATH=/storage/clienti
BACKUP_PATH=/volume1/docker/eh-moduli/backups

# Docker user ID and GID (for file permissions)
# Default 1000 - change if Synology uses different IDs
APPUSER_UID=1000
APPUSER_GID=1000

# ========================================
# Gunicorn Application Server Configuration
# ========================================

# Number of Gunicorn workers
# For NAS with limited resources: 2-3
# For production server: CPU_CORES * 2 + 1
# Default: 3 (appropriate for most NAS)
GUNICORN_WORKERS=3

# Worker timeout (seconds)
# Increase if uploads are slow or long operations needed
GUNICORN_TIMEOUT=60

# Gunicorn log level (debug | info | warning | error | critical)
GUNICORN_LOG_LEVEL=info

# ========================================
# Django Superuser Creation (First Deployment Only)
# ========================================

# Set to 'true' only on FIRST deployment to create admin user
# After first deployment, set to 'false' to prevent recreation
# If set to true without password, superuser creation is skipped
CREATE_SUPERUSER=false

# Superuser credentials (only used if CREATE_SUPERUSER=true)
# These are NOT logged - they're only used for user creation
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=gianvito.bleve@gmail.com
DJANGO_SUPERUSER_PASSWORD=gianvito

# ========================================
# Deployment Instructions
# ========================================

# 1. Create directories on Synology NAS (via SSH or SMB):
#    mkdir -p /volume1/docker/eh-moduli/{appdata,postgres,backups}
#    mkdir -p /volume1/Clienti
#    chmod 755 /volume1/Clienti

# 2. Copy this file:
#    cp .env.example .env

# 3. Edit .env with actual values:
#    - SECRET_KEY: Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#    - POSTGRES_PASSWORD: Run: openssl rand -base64 32
#    - ALLOWED_HOSTS: Your NAS IP or hostname
#    - DJANGO_SUPERUSER_PASSWORD: Strong password for admin account

# 4. First deployment only:
#    CREATE_SUPERUSER=true
#    DJANGO_SUPERUSER_PASSWORD=<admin_password>

# 5. Start containers:
#    docker-compose up --build

# 6. After first deployment succeeds:
#    - Edit .env: CREATE_SUPERUSER=false
#    - Restart container: docker-compose restart app

# ========================================
# Security Notes
# ========================================

# NEVER commit .env to Git
# .env is in .gitignore - verify with: git ls-files | grep .env
#
# If .env was ever committed:
#   1. All secrets must be rotated
#   2. Revoke all tokens/passwords
#   3. Force-push to remove from history
#   4. Run: git filter-branch --force --index-filter ...
#
# Verify secrets are in .gitignore:
#   - .env
#   - .env.local
#   - *.env
#   - db.sqlite3
#   - data/
#   - staticfiles/

# ========================================
# Monitoring & Logging
# ========================================

# Application logs are output to container stdout/stderr
# View logs: docker-compose logs -f app
#
# PostgreSQL logs: docker-compose logs -f db
#
# Health status: docker-compose ps
#
# Healthcheck URLs:
#   - Liveness: http://NAS_IP:6060/health/
#   - Readiness: http://NAS_IP:6060/health/ready/
